  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: fde8638d1edd5fb4a9cb3fb0a8d7eabb, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::NavMeshLesson.DemoZone
  title: "\u041C\u0430\u0439\u0441\u0442\u0435\u0440 \u043B\u0430\u043D\u0434\u0448\u0430\u0444\u0442\u0456\u0432:
    \u0441\u0445\u043E\u0434\u0438\u043D\u043A\u0438, \u043C\u0456\u0441\u0442, \u043E\u0441\u0442\u0440\u043E\u0432\u0438"
  hint: "\u041B\u041A\u041C \u043F\u043E \u0431\u0443\u0434\u044C-\u044F\u043A\u0456\u0439
    \u043F\u043E\u0432\u0435\u0440\u0445\u043D\u0456 \u2014 \u0430\u0433\u0435\u043D\u0442
    \u0456\u0434\u0435 \u0442\u0443\u0434\u0438. \u0421\u0445\u043E\u0434\u0438\u043D\u043A\u0438
    (0.35 \u043C) \u043D\u0438\u0436\u0447\u0456 \u0437\u0430 Step Height (0.75 \u043C),
    \u0442\u043E\u043C\u0443 \u0430\u0433\u0435\u043D\u0442 \u043F\u043E \u043D\u0438\u0445
    \u043F\u0456\u0434\u043D\u0456\u043C\u0430\u0454\u0442\u044C\u0441\u044F. \u041C\u0456\u0436
    \u043F\u0435\u0440\u0448\u0438\u043C\u0438 \u043E\u0441\u0442\u0440\u043E\u0432\u0430\u043C\u0438
    \u2014 \u043B\u0438\u0448\u0435 \u0432\u0443\u0437\u044C\u043A\u0438\u0439 \u043C\u0456\u0441\u0442.
    \u041D\u0430 \u0434\u0430\u043B\u044C\u043D\u0456\u0439 \u043E\u0441\u0442\u0440\u0456\u0432
    \u0448\u043B\u044F\u0445\u0443 \u043D\u0435\u043C\u0430\u0454: \u0441\u0442\u0430\u0442\u0443\u0441
    \u043F\u043E\u043A\u0430\u0436\u0435 PathPartial."
