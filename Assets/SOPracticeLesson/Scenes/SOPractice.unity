  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::SOPractice.DemoInfo
  title: "3.1 \u041E\u0434\u0438\u043D \u0441\u043A\u0440\u0438\u043F\u0442 \u2014
    \u0440\u0456\u0437\u043D\u0456 \u0432\u043E\u0440\u043E\u0433\u0438"
  hint: "\u0422\u0440\u0438 \u0432\u043E\u0440\u043E\u0433\u0438 \u0437 \u043E\u0434\u043D\u043E\u0433\u043E
    \u043F\u0440\u0435\u0444\u0430\u0431\u0430 EnemyCube: \u043A\u043E\u043B\u0456\u0440,
    \u0456\u043C'\u044F, HP \u0456 \u0448\u0432\u0438\u0434\u043A\u0456\u0441\u0442\u044C
    \u0431\u0435\u0440\u0443\u0442\u044C\u0441\u044F \u0437 EnemyData.asset. \u041A\u043D\u043E\u043F\u043A\u0430
    \xAB\u0417\u0430\u0432\u0434\u0430\u0442\u0438 \u0448\u043A\u043E\u0434\u0443\xBB
    \u2014 DamageAllEnemies() \u0437 \u043F\u0456\u0434\u043A\u0430\u0437\u043A\u0438
    \u0443\u0440\u043E\u043A\u0443. \u041F\u0440\u0435\u0434\u043C\u0435\u0442\u0438
    \u0442\u0435\u0436 \u043A\u043B\u0456\u043A\u0430\u044E\u0442\u044C\u0441\u044F.
    \u0417\u043C\u0456\u043D\u0438 HP \u0434\u0440\u0430\u043A\u043E\u043D\u0430
    \u0432 EnemyData_Dragon.asset \u0456 \u043D\u0430\u0442\u0438\u0441\u043D\u0438
    [R] \u2014 \u0431\u0435\u0437 \u0437\u043C\u0456\u043D\u0438 \u043A\u043E\u0434\u0443."
