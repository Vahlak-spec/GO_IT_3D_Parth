  m_Script: {fileID: 11500000, guid: 28cb967aec0b80f44b0677166d1f9b11, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::SOPractice.DemoInfo
  title: "2.1 SelectionManager (\u043E\u0434\u0438\u043D \u043C\u0435\u043D\u0435\u0434\u0436\u0435\u0440
    + Raycast)"
  hint: "\u041A\u043B\u0456\u043A\u043D\u0438 \u043F\u043E \u043F\u0440\u0435\u0434\u043C\u0435\u0442\u0443
    \u2014 \u043F\u0430\u043D\u0435\u043B\u044C \u0432\u0456\u0434\u043A\u0440\u0438\u0432\u0430\u0454\u0442\u044C\u0441\u044F.
    \u041F\u043E\u0432\u0442\u043E\u0440\u043D\u0438\u0439 \u043A\u043B\u0456\u043A
    \u043F\u043E \u0442\u043E\u043C\u0443 \u0441\u0430\u043C\u043E\u043C\u0443 \u2014
    \u0437\u0430\u043A\u0440\u0438\u0432\u0430\u0454\u0442\u044C\u0441\u044F. \u041A\u043B\u0456\u043A
    \u0443 \u043F\u043E\u0440\u043E\u0436\u043D\u0435\u0447\u0443 \u2014 \u0442\u0435\u0436
    \u0437\u0430\u043A\u0440\u0438\u0432\u0430\u0454\u0442\u044C\u0441\u044F. \u0423\u0441\u044F
    \u043B\u043E\u0433\u0456\u043A\u0430 \u0432 \u043E\u0434\u043D\u043E\u043C\u0443
    \u0441\u043A\u0440\u0438\u043F\u0442\u0456, \u043F\u0440\u0435\u0434\u043C\u0435\u0442\u0438
    \u043C\u0456\u0441\u0442\u044F\u0442\u044C \u043B\u0438\u0448\u0435 SelectableItem
    \u0437 \u0434\u0430\u043D\u0438\u043C\u0438."
  enableWhileActive:
  - {fileID: 272147999}
  showWhileActive: []
  panel: {fileID: 953112042}
