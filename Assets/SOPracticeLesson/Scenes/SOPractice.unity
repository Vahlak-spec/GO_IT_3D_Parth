  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::SOPractice.DemoInfo
  title: "1.1\u20132.1 ClickableItem (IPointerClickHandler)"
  hint: "\u041A\u043B\u0456\u043A\u043D\u0438 \u043F\u043E \u043F\u0440\u0435\u0434\u043C\u0435\u0442\u0443
    \u2014 \u043F\u0430\u043D\u0435\u043B\u044C \u043F\u043E\u043A\u0430\u0436\u0435
    \u0434\u0430\u043D\u0456 \u0437 \u0439\u043E\u0433\u043E ItemData.asset. \u041F\u0440\u0430\u0446\u044E\u0454
    \u0447\u0435\u0440\u0435\u0437 EventSystem: \u043D\u0430 \u043A\u0430\u043C\u0435\u0440\u0456
    Physics Raycaster, \u043D\u0430 \u043A\u043E\u0436\u043D\u043E\u043C\u0443 \u043F\u0440\u0435\u0434\u043C\u0435\u0442\u0456
    \u2014 \u0441\u0432\u0456\u0439 ClickableItem. \u041A\u043B\u0456\u043A \u0443
    \u043F\u043E\u0440\u043E\u0436\u043D\u0435\u0447\u0443 \u043F\u0430\u043D\u0435\u043B\u044C
    \u043D\u0435 \u0437\u0430\u043A\u0440\u0438\u0432\u0430\u0454 \u2014 \u0443 \u0446\u044C\u043E\u043C\u0443
    \u043F\u0456\u0434\u0445\u043E\u0434\u0456 \u0446\u044C\u043E\u0433\u043E \u043D\u0435\u043C\u0430\u0454."
  enableWhileActive:
